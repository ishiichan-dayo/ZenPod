{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZenPod",
  "mainBinaryName": "ZenPod",
  "version": "2.12.1",
  "identifier": "app.ipodsync.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZenPod",
        "width": 1120,
        "height": 740,
        "minWidth": 820,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://*.mzstatic.com https://*.dzcdn.net https://coverartarchive.org https://archive.org https://*.archive.org",
        "media-src": "'self' blob: ipodaudio: http://ipodaudio.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost ipodaudio: http://ipodaudio.localhost https://stats.leatomi.com",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "license": "GPL-3.0-or-later",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxMTdDMUVBMEUzQUIzQUUKUldTdXN6b082c0VYUWMyeTJSM3VuNzhmRkNraDhsREZIcUdhaW1NNTVCQzRGZGtPZGxxMEVRUE8K",
      "endpoints": [
        "https://github.com/ishiichan-dayo/ZenPod/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
